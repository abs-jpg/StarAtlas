%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4949777a97fbb82488006f3e3b6b8b01, type: 3}
  m_Name: ExhibitionCatalog
  m_EditorClassIdentifier: 
  entries:
  - displayName: "\u592A\u9633"
    title: "\u592A\u9633"
    prefab: {fileID: 7271790581479100636, guid: 869227db1f0060a4fa1f928f88f2e15d,
      type: 3}
    previewDiameter: 0.08
    previewEulerAngles: {x: 0, y: 0, z: 0}
    spawnedScale: {x: 0.25, y: 0.25, z: 0.25}
    spawnedEulerAngles: {x: 0, y: 0, z: 0}
    planetSystem: 0
    primaryMoonPrefab: {fileID: 0}
    summary: "太阳是一颗约46亿岁的黄矮星，集中了太阳系约99.8%的质量，引力维系着行星、卫星、小行星和彗星的轨道。它主要由氢和氦组成，核心持续进行氢聚变并释放光与热；核心温度约1500万摄氏度，可见光球层约5500摄氏度。太阳没有固体表面，不同纬度的等离子体自转速度不同。活跃磁场会产生黑子、耀斑和日冕物质抛射，太阳风向外形成覆盖整个行星区域的日球层，并可能在地球引发极光和空间天气扰动。"
    diameter: "约1,392,700千米"
    mass: "约1.989 × 10^30千克"
    orbitPeriod: "约2.3亿年（绕银河系中心）"
    rotationPeriod: "赤道约25天，极区约36天"
    enableSpawnedRotation: 1
    spawnedRotationDegreesPerSecond: 0.755
    defaultTemperatureCelsius: 5500
    orbitSpeedAffectsTemperature: 0
    rotationSpeedAffectsTemperature: 1
  - displayName: "\u6C34\u661F"
    title: "\u6C34\u661F"
    prefab: {fileID: 3885845253069203268, guid: 829bfd56a023e354ea56ad97db914d71,
      type: 3}
    previewDiameter: 0.08
    previewEulerAngles: {x: 0, y: 0, z: 0}
    spawnedScale: {x: 0.25, y: 0.25, z: 0.25}
    spawnedEulerAngles: {x: 0, y: 0, z: 0}
    planetSystem: 0
    primaryMoonPrefab: {fileID: 0}
    summary: "水星是距离太阳最近、也是八大行星中最小的一颗岩石行星。它拥有比例异常巨大的富铁核心，表面遍布撞击坑、悬崖和平原，外观与月球相似。水星只有由氧、钠、氢、氦和钾等稀薄粒子构成的外逸层，无法像真正大气那样保存热量，因此白昼表面可超过430摄氏度，夜间可降到约零下180摄氏度。它每自转3周恰好绕太阳运行2周，形成3:2自转轨道共振。水星没有天然卫星，也没有星环。"
    diameter: "约4,879千米"
    mass: "约3.301 × 10^23千克"
    orbitPeriod: "87.97天"
    rotationPeriod: "58.65天"
    enableSpawnedRotation: 1
    spawnedRotationDegreesPerSecond: 0.341
    defaultTemperatureCelsius: 167
    orbitSpeedAffectsTemperature: 1
    rotationSpeedAffectsTemperature: 1
  - displayName: "\u91D1\u661F"
    title: "\u91D1\u661F"
    prefab: {fileID: 7979434382999846474, guid: 9390bdf8dffaf5d4aafa08b6abc1d811,
      type: 3}
    previewDiameter: 0.08
    previewEulerAngles: {x: 0, y: 0, z: 0}
    spawnedScale: {x: 0.25, y: 0.25, z: 0.25}
    spawnedEulerAngles: {x: 0, y: 0, z: 0}
    planetSystem: 0
    primaryMoonPrefab: {fileID: 0}
    summary: "金星的直径和质量与地球接近，却拥有完全不同的环境。其浓厚大气约96%是二氧化碳，上层覆盖硫酸云，地表气压约为地球海平面的92倍。失控的温室效应使全球平均表面温度约464摄氏度，比更靠近太阳的水星还热。金星表面分布着广阔火山平原、山地和大量火山构造，是否仍存在火山活动仍是重要研究问题。它自转极慢且方向与多数行星相反，因此太阳会从西方升起。金星没有天然卫星，也没有星环。"
    diameter: "约12,104千米"
    mass: "约4.867 × 10^24千克"
    orbitPeriod: "224.70天"
    rotationPeriod: "243.02天（逆行）"
    enableSpawnedRotation: 1
    spawnedRotationDegreesPerSecond: -0.082
    defaultTemperatureCelsius: 464
    orbitSpeedAffectsTemperature: 1
    rotationSpeedAffectsTemperature: 1
  - displayName: "\u5730\u7403"
    title: "\u5730\u7403"
    prefab: {fileID: 7765523008238663313, guid: 7889a31ca6f6c7049abfddc1b7b9b326,
      type: 3}
    previewDiameter: 0.08
    previewEulerAngles: {x: 0, y: 0, z: 0}
    spawnedScale: {x: 0.25, y: 0.25, z: 0.25}
    spawnedEulerAngles: {x: 0, y: 0, z: 0}
    planetSystem: 1
    primaryMoonPrefab: {fileID: 995716104177521626, guid: 6f60e2696aee62446be9cca2adffdad2,
      type: 3}
    summary: "地球是目前已知唯一拥有广泛稳定液态水和生命的行星。海洋覆盖约71%的表面，以氮和氧为主的大气调节温度并保护生命，内部活动推动板块构造、火山和地磁场的形成。磁层能够偏转大量太阳风粒子，大气中的水循环和碳循环共同维持长期宜居环境。地球拥有1颗天然卫星月球，没有行星环。月球的引力造成潮汐，并帮助稳定地球约23.4度的自转轴倾角；月球被地球潮汐锁定，因此始终以近似同一面朝向地球。"
    diameter: "约12,742千米"
    mass: "约5.972 × 10^24千克"
    orbitPeriod: "365.256天"
    rotationPeriod: "23小时56分"
    enableSpawnedRotation: 1
    spawnedRotationDegreesPerSecond: 20
    defaultTemperatureCelsius: 15
    orbitSpeedAffectsTemperature: 1
    rotationSpeedAffectsTemperature: 1
  - displayName: "\u706B\u661F"
    title: "\u706B\u661F"
    prefab: {fileID: 3981193673885259943, guid: 06039319a8a89cc478f8f99f0bc793e4,
      type: 3}
    previewDiameter: 0.08
    previewEulerAngles: {x: 0, y: 0, z: 0}
    spawnedScale: {x: 0.25, y: 0.25, z: 0.25}
    spawnedEulerAngles: {x: 0, y: 0, z: 0}
    planetSystem: 2
    primaryMoonPrefab: {fileID: 0}
    summary: "火星是一颗寒冷、干燥且布满尘埃的岩石行星，土壤中的氧化铁使它呈现红色。稀薄大气主要由二氧化碳组成，无法有效保存热量，全球性沙尘暴有时可持续数周。火星拥有太阳系最高的大型火山奥林帕斯山和巨大的水手号峡谷，古河道、三角洲与湖床证明早期火星曾更温暖湿润。它有2颗不规则小卫星：较近的火卫一和较远的火卫二；火卫一正缓慢接近火星，未来可能破碎形成短暂尘埃环。火星目前没有星环。"
    diameter: "约6,779千米"
    mass: "约6.417 × 10^23千克"
    orbitPeriod: "686.98天"
    rotationPeriod: "24小时37分"
    enableSpawnedRotation: 1
    spawnedRotationDegreesPerSecond: 19.512
    defaultTemperatureCelsius: -63
    orbitSpeedAffectsTemperature: 1
    rotationSpeedAffectsTemperature: 1
  - displayName: "\u6728\u661F"
    title: "\u6728\u661F"
    prefab: {fileID: 8936252349162820525, guid: eaf138b85a3d24f4a8bdd0776a2c8ac5,
      type: 3}
    previewDiameter: 0.08
    previewEulerAngles: {x: 0, y: 0, z: 0}
    spawnedScale: {x: 0.25, y: 0.25, z: 0.25}
    spawnedEulerAngles: {x: 0, y: 0, z: 0}
    planetSystem: 3
    primaryMoonPrefab: {fileID: 0}
    summary: "木星是太阳系最大的行星，质量超过其他七颗行星质量总和的两倍。它主要由氢和氦组成，没有明确固体表面，快速自转把云层拉成明暗相间的带状结构，并形成持续数百年的大红斑风暴。木星拥有极强磁场和巨大的磁层。JPL当前数据记录115颗卫星，其中木卫一火山活动剧烈，木卫二可能拥有冰下海洋，木卫三是太阳系最大卫星，木卫四表面遍布古老撞击坑。木星还拥有由尘埃构成的暗淡星环，包括晕环、主环和两层蛛网状环。"
    diameter: "约139,820千米"
    mass: "约1.898 × 10^27千克"
    orbitPeriod: "11.86年"
    rotationPeriod: "9小时56分"
    enableSpawnedRotation: 1
    spawnedRotationDegreesPerSecond: 48.485
    defaultTemperatureCelsius: -108
    orbitSpeedAffectsTemperature: 1
    rotationSpeedAffectsTemperature: 1
  - displayName: "\u571F\u661F"
    title: "\u571F\u661F"
    prefab: {fileID: 5754648943945272369, guid: 1b021db6e524b954c83ba6e97b903ce1,
      type: 3}
    previewDiameter: 0.08
    previewEulerAngles: {x: 0, y: 0, z: 0}
    spawnedScale: {x: 0.25, y: 0.25, z: 0.25}
    spawnedEulerAngles: {x: 0, y: 0, z: 0}
    planetSystem: 4
    primaryMoonPrefab: {fileID: 0}
    summary: "土星是太阳系第二大行星，也是一颗主要由氢和氦组成的气态巨行星。它的平均密度低于水，快速自转使赤道明显隆起。壮观的星环主要由水冰颗粒混合少量岩石和尘埃组成，A、B、C等主环之间分布着大量细环和缝隙，其中最醒目的是卡西尼缝。JPL当前数据记录291颗卫星：土卫六拥有浓厚氮气大气和液态甲烷湖，土卫二会从南极喷出含水冰物质，暗示地下存在全球性海洋。卫星引力还会塑造和约束许多环缝与环带。"
    diameter: "约116,460千米"
    mass: "约5.683 × 10^26千克"
    orbitPeriod: "29.45年"
    rotationPeriod: "约10小时42分"
    enableSpawnedRotation: 1
    spawnedRotationDegreesPerSecond: 44.86
    defaultTemperatureCelsius: -139
    orbitSpeedAffectsTemperature: 1
    rotationSpeedAffectsTemperature: 1
  - displayName: "\u5929\u738B\u661F"
    title: "\u5929\u738B\u661F"
    prefab: {fileID: 6428949619592926398, guid: 2e9d0e789375a194cb1440811ef89b7d,
      type: 3}
    previewDiameter: 0.08
    previewEulerAngles: {x: 0, y: 0, z: 0}
    spawnedScale: {x: 0.25, y: 0.25, z: 0.25}
    spawnedEulerAngles: {x: 0, y: 0, z: 0}
    planetSystem: 5
    primaryMoonPrefab: {fileID: 0}
    summary: "天王星是由水、氨、甲烷等高压流体和氢氦大气构成的冰巨星，甲烷吸收红光，使云顶呈淡青蓝色。它最特殊的特征是约97.8度的自转轴倾角，整颗行星几乎横躺着绕太阳运行，而且自转方向与多数行星相反。这使每个极区都可能连续经历约21年的白昼或黑夜。JPL当前数据记录29颗卫星，主要卫星包括天卫五、天卫一、天卫二、天卫三和天卫四。天王星还拥有13条已知暗色窄环，环面也随倾斜的赤道一起近乎侧立。"
    diameter: "约50,724千米"
    mass: "约8.681 × 10^25千克"
    orbitPeriod: "84.01年"
    rotationPeriod: "17小时14分（逆行）"
    enableSpawnedRotation: 1
    spawnedRotationDegreesPerSecond: -27.907
    defaultTemperatureCelsius: -197
    orbitSpeedAffectsTemperature: 1
    rotationSpeedAffectsTemperature: 1
  - displayName: "\u6D77\u738B\u661F"
    title: "\u6D77\u738B\u661F"
    prefab: {fileID: 1487389192617538027, guid: eec6cf8d3e0ffd04b951e4fad49cdab7,
      type: 3}
    previewDiameter: 0.08
    previewEulerAngles: {x: 0, y: 0, z: 0}
    spawnedScale: {x: 0.25, y: 0.25, z: 0.25}
    spawnedEulerAngles: {x: 0, y: 0, z: 0}
    planetSystem: 6
    primaryMoonPrefab: {fileID: 0}
    summary: "海王星是距离太阳最远的八大行星，平均距离约30个天文单位，是一颗寒冷的冰巨星。它的大气以氢、氦和甲烷为主，内部热量驱动着太阳系中最猛烈的天气之一，云层风速可超过每小时2000千米，并会形成不断出现和消散的暗色风暴。海王星拥有16颗已知卫星，其中最大的海卫一沿逆行轨道运行，可能是被捕获的柯伊伯带天体，表面还有氮冰喷泉。它至少拥有5条主环，最外侧亚当斯环中聚集着自由、平等、博爱和勇气等明亮环弧。"
    diameter: "约49,244千米"
    mass: "约1.024 × 10^26千克"
    orbitPeriod: "164.8年"
    rotationPeriod: "约16小时6分"
    enableSpawnedRotation: 1
    spawnedRotationDegreesPerSecond: 29.814
    defaultTemperatureCelsius: -201
    orbitSpeedAffectsTemperature: 1
    rotationSpeedAffectsTemperature: 1
